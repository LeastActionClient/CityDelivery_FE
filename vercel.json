{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "citydeliveryservices.com" }],
      "destination": "https://www.citydeliveryservices.com/:path*",
      "permanent": true
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/assets/.+$", "status": 404, "headers": { "Cache-Control": "no-store" } },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
